# Chave criada em https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-sua-chave-aqui

# Modelos usados para vetorizacao e resposta.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Banco iniciado pelo docker-compose.yml.
POSTGRES_CONNECTION=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PGVECTOR_COLLECTION=pdf_documents

# Caminho do PDF, relativo a raiz do projeto ou absoluto.
PDF_PATH=document.pdf

# true substitui a collection em cada ingestao e evita chunks duplicados.
RECREATE_COLLECTION=true
